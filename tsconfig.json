{
  "compilerOptions": {
    "target": "ES2020",                                  /* Define a versão do JavaScript de destino para a compilação */
    "module": "ESNext",                                   /* Use ESNext para módulos */
    "moduleResolution": "node",                           /* Use a resolução de módulos do Node.js */
    "noEmit": true, 
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,                              /* Permite importar módulos CommonJS como se fossem ES6 */
    "strict": true,                                       /* Habilita o modo estrito para detectar erros mais cedo */
    "skipLibCheck": true,                                 /* Ignora a verificação de tipos em arquivos de definição de biblioteca */
    "outDir": "./dist",                                   /* Define o diretório de saída para os arquivos compilados */
    "sourceMap": true,                                    /* Gera arquivos de mapa de origem para depuração */
    "resolveJsonModule": true,                            /* Permite importar arquivos JSON */
    "forceConsistentCasingInFileNames": true              /* Garante que o casing dos nomes de arquivos seja consistente */
    
  },
  "include": ["src/**/*"],                                /* Define os arquivos de entrada para o TypeScript */
  "exclude": ["node_modules"]                             /* Exclui o diretório node_modules */
}
